model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  content   String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id         String            @id @default(uuid())
  orderId    String            @unique
  userId     String
  amount     Int
  status     TransactionStatus @default(PENDING)
  paymentUrl String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// ENTITAS BARU UNTUK KEBUTUHAN DASHBOARD
// ==========================================

// 1. Model untuk "Total Regulasi" & "Dokumen Terpopuler"
model Regulation {
  id          String   @id @default(uuid())
  title       String   // Contoh: "UU ITE", "KUHP"
  description String?  @db.Text
  content     String?  @db.Text
  viewCount   Int      @default(0) // Kunci utama untuk query "Dokumen Terpopuler"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 2. Model untuk "Isu Terkini"
model TrendingIssue {
  id          String   @id @default(uuid())
  title       String   // Contoh: "Maling Helm di unpad"
  description String   @db.Text // Contoh: "Pelaku kabur ke Pangdam"
  location    String?  // Opsional, untuk menyimpan lokasi isu
  createdAt   DateTime @default(now()) // Digunakan frontend untuk hitung "X Jam Lalu"
  updatedAt   DateTime @updatedAt
}

// 3. Model untuk "Tren Pencarian Hukum" (Time-series data)
model SearchLog {
  id        String   @id @default(uuid())
  query     String   // Kata kunci yang dicari user
  userId    String?  // Nullable, berjaga-jaga jika ada pencarian anonim
  createdAt DateTime @default(now()) // Digunakan untuk agregasi data per hari/bulan pada grafik

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum Tier {
  FREE
  PRO
}

enum Role {
  USER
  ADMIN
  AI
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}