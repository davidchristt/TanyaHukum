skinparam ArrowFontSize 9

' ── Sistem Pusat ──────────────────────────────────────────
component "SISTEM\nTANYAHUKUM\n\nPlatform AI Konsultasi Hukum\nBerbasis RAG" as SYS #EEF4FF

' ── Entitas Eksternal ─────────────────────────────────────
rectangle "Pengguna\n(User FREE/PRO)" as USER #FDEBD0
rectangle "Admin\n(Pengelola Platform)" as ADMIN #FDEBD0

rectangle "Google OAuth 2.0\nServer" as GOOGLE #F5EEF8
rectangle "Midtrans\nPayment Gateway" as MIDTRANS #F5EEF8
rectangle "VoyageAI\n(voyage-law-2\nEmbedding API)" as VOYAGE #F5EEF8
rectangle "Pinecone\n(Vector Database)" as PINECONE #F5EEF8
