' ============================================================
' 5. SEQUENCE DIAGRAM — LOGIN EMAIL
' ============================================================
@startuml SEQ-01-Login
title Sequence Diagram — Login Email\nPOST /api/auth/login

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 10
  BoxBackgroundColor #F8F9FA
}

actor "Pengguna" as USER
participant "LoginForm\n(React)" as UI
participant "POST /api/auth/login\n(Route Handler)" as API
participant "rateLimit\n(LRU Cache)" as RL
database "PostgreSQL\n(Prisma)" as DB
participant "bcryptjs" as BCRYPT
participant "jose\n(JWT)" as JWT

USER -> UI : input email & password\nklik Masuk
activate UI

UI -> API : POST /api/auth/login\n{email, password}
activate API

API -> RL : rateLimit(ip, 5)
activate RL
RL --> API : allowed / blocked
deactivate RL

alt Rate limit tercapai
  API --> UI : HTTP 429\n"Terlalu banyak percobaan"
  UI --> USER : tampil pesan error
end

API -> API : validateInput(email, password)\n(regex + type check)

alt Validasi gagal
  API --> UI : HTTP 400\npesan validasi
  UI --> USER : tampil pesan error
end

API -> DB : user.findUnique(email.toLowerCase())
activate DB
DB --> API : user | null
deactivate DB

API -> BCRYPT : compare(password, user?.passwordHash ?? dummyHash)
note right of BCRYPT
  Selalu jalankan bcrypt
  meski user=null untuk
  mencegah timing attack
end note
activate BCRYPT
BCRYPT --> API : isValid: boolean
deactivate BCRYPT

alt user null atau password tidak cocok
  API --> UI : HTTP 401\n"Email atau password salah"
  UI --> USER : tampil pesan error
end

API -> JWT : SignJWT({userId, email, tier, role})
activate JWT
JWT --> API : token string
deactivate JWT

API --> UI : HTTP 200\nSet-Cookie: token=... (HttpOnly, 7 hari)\n{user: {id, email, tier, role, name, avatarUrl}}
deactivate API

UI -> UI : localStorage.setItem("user", JSON.stringify(user))
UI -> UI : dispatchEvent("auth-change")
UI --> USER : redirect ke /chatbot
deactivate UI

@enduml

' ============================================================
' 6. SEQUENCE DIAGRAM — CHAT RAG (FITUR UTAMA)
' ============================================================
@startuml SEQ-02-ChatRAG
title Sequence Diagram — Chat RAG Pipeline\nPOST /api/chat

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 9
  BoxBackgroundColor #F8F9FA
}

actor "Pengguna" as USER
participant "ChatArea\n(React)" as UI
participant "POST /api/chat\n(Route Handler)" as API
participant "getSession()\n(jose JWT)" as SESSION
database "PostgreSQL\n(Prisma)" as DB
participant "VoyageAI\nvoyage-law-2" as VOYAGE
participant "Pinecone\nVector DB" as PINECONE
participant "Gemini 2.5 Flash\n(LangChain)" as GEMINI

USER -> UI : ketik pertanyaan hukum\nklik Kirim
activate UI
UI -> UI : tampil loading state

UI -> API : POST /api/chat\n{message, chatId?}\n[Cookie: token=...]
activate API

API -> SESSION : getSession() — decode JWT cookie
activate SESSION
SESSION --> API : {userId, email, tier, role} | null
deactivate SESSION

alt Tidak ada sesi
  API --> UI : HTTP 401
  UI --> USER : redirect ke login
end

alt Pesan kosong
  API --> UI : HTTP 400
end

API -> DB : user.findUnique({id: userId})
activate DB
DB --> API : user (tier, promptLimit, personalContext)
deactivate DB

alt User tidak ditemukan
  API --> UI : HTTP 404
end

API -> DB : chatHistory.count(userId, role=USER, hari ini)
activate DB
DB --> API : chatsTodayCount
deactivate DB

alt tier=FREE && chatsTodayCount >= promptLimit
  API --> UI : HTTP 403\n{limitReached: true}
  UI --> USER : tampil modal upgrade PRO
end

note over API, GEMINI
  ═══════ RAG PIPELINE ═══════
end note

API -> VOYAGE : embedQuery(message)
activate VOYAGE
VOYAGE --> API : queryVector float[1024]
deactivate VOYAGE

API -> PINECONE : index.query(vector, topK: 50)
activate PINECONE
PINECONE --> API : matches[]\n(text, title, page, score)
deactivate PINECONE

API -> API : susun konteks:\n"[DOKUMEN N | Sumber | Hal]\n{text}"

API -> API : bangun systemPrompt\n(role TanyaHukum + konteks +\npersonalContext + aturan format)

API -> GEMINI : invoke([SystemMessage, HumanMessage])
activate GEMINI

alt Gemini quota habis (429)
  GEMINI --> API : error 429
  API --> UI : HTTP 429\n"Kuota AI habis"
end

GEMINI --> API : response.content (Markdown)
deactivate GEMINI

note over API, DB
  ═══════ SIMPAN KE DATABASE ═══════
end note

alt chatId ada
  API -> DB : chat.findUnique(chatId)
  activate DB
  DB --> API : chatSession
  deactivate DB
else chatId tidak ada
  API -> DB : chat.create(title=pesan[:30])
  activate DB
  DB --> API : chatSession baru
  deactivate DB
end

API -> DB : Promise.all:\n1. chatHistory.create(role=USER, message)\n2. chatHistory.create(role=AI, response)\n3. chat.update(updatedAt)
activate DB
DB --> API : saved
deactivate DB

API --> UI : HTTP 200\n{answer: Markdown, chatId}
deactivate API

UI -> UI : render jawaban\ndengan react-markdown
UI --> USER : tampil jawaban AI\n+ sumber dokumen
deactivate UI

@enduml

' ============================================================
' 7. SEQUENCE DIAGRAM — GOOGLE OAUTH
' ============================================================
@startuml SEQ-03-GoogleOAuth
title Sequence Diagram — Login / Register Google OAuth\nPOST /api/auth/google

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 9
}

actor "Pengguna" as USER
participant "LoginForm /\nRegisterForm\n(React)" as UI
participant "Google GSI\nSDK" as GSI
participant "Google OAuth\nServer" as GOOGLE
participant "POST /api/auth/google\n(Route Handler)" as API
participant "OAuth2Client\n(google-auth-library)" as GCLIENT
database "PostgreSQL\n(Prisma)" as DB
participant "jose (JWT)" as JWT

USER -> UI : klik tombol\n"Login with Google"
activate UI

UI -> GSI : google.accounts.id.initialize\n(client_id, callback)
activate GSI
UI -> GSI : renderButton(container)

GSI --> USER : tampil tombol Google
USER -> GSI : klik tombol

GSI -> GOOGLE : buka popup pilih akun Google
activate GOOGLE
USER -> GOOGLE : pilih akun
GOOGLE --> GSI : credential token (JWT)
deactivate GOOGLE

GSI -> UI : callback(response.credential)
deactivate GSI

UI -> API : POST /api/auth/google\n{credentialToken}
activate API

API -> GCLIENT : verifyIdToken({idToken, audience})
activate GCLIENT
GCLIENT -> GOOGLE : verifikasi token
GOOGLE --> GCLIENT : payload valid | throw error
deactivate GCLIENT

alt Token palsu / expired
  API --> UI : HTTP 401\n"Token tidak valid"
  UI --> USER : tampil error
end

API -> API : ambil email, name, picture\ndari payload

API -> DB : user.findUnique({email})
activate DB
DB --> API : user | null
deactivate DB

alt User belum terdaftar
  API -> DB : user.create(\n  email, name, avatarUrl: picture\n  authProvider: GOOGLE\n  tier: FREE, role: USER\n)
  activate DB
  DB --> API : user baru
  deactivate DB
else User sudah ada
  note over API : gunakan data user yang ada
end

API -> JWT : SignJWT({userId, email, tier, role})
activate JWT
JWT --> API : token string
deactivate JWT

API --> UI : HTTP 200\nSet-Cookie: token=... (HttpOnly)\n{user: {id, email, tier, role, name, avatarUrl}}
deactivate API

UI -> UI : localStorage.setItem("user", ...)\ndispatchEvent("auth-change")
UI --> USER : redirect ke /chatbot
deactivate UI

@enduml

' ============================================================
' 8. SEQUENCE DIAGRAM — PAYMENT UPGRADE PRO
' ============================================================
@startuml SEQ-04-Payment
title Sequence Diagram — Payment Upgrade PRO\nMidtrans Snap + Webhook

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 9
}

actor "Pengguna" as USER
participant "Frontend\n(React)" as UI
participant "POST /api/payment\n/checkout" as CHECKOUT
participant "POST /api/payment\n/webhook" as WEBHOOK
participant "GET /api/profile\n(self-healing)" as PROFILE
database "PostgreSQL\n(Prisma)" as DB
participant "Midtrans\nSnap API" as SNAP
participant "Midtrans\nCoreAPI" as CORE

USER -> UI : klik "Upgrade ke PRO"
activate UI

UI -> CHECKOUT : POST {userId}
activate CHECKOUT

CHECKOUT -> DB : user.findUnique(userId)
activate DB
DB --> CHECKOUT : {email, tier}
deactivate DB

alt User sudah PRO
  CHECKOUT --> UI : HTTP 400
  UI --> USER : "Sudah berlangganan PRO"
end

CHECKOUT -> CHECKOUT : generate orderId\n= TRX-{timestamp}-{userId[:5]}

CHECKOUT -> DB : transaction.create\n{orderId, PENDING, 49900}
activate DB
DB --> CHECKOUT : ok
deactivate DB

CHECKOUT -> SNAP : createTransaction\n{orderId, amount, email}
activate SNAP
SNAP --> CHECKOUT : {token, redirect_url}
deactivate SNAP

CHECKOUT -> DB : transaction.update\n{paymentUrl: redirect_url}
activate DB
DB --> CHECKOUT : ok
deactivate DB

CHECKOUT --> UI : HTTP 200\n{token, redirect_url}
deactivate CHECKOUT

UI -> UI : buka Midtrans Snap popup\n(window.snap.pay(token))
USER -> UI : lakukan pembayaran\n(transfer/e-wallet/kartu)

note over UI, SNAP
  Pengguna menyelesaikan pembayaran
  di popup Midtrans Snap
end note

== Notifikasi Webhook (Async) ==

SNAP -> WEBHOOK : POST\n{order_id, transaction_status\nfraud_status, signature_key}
activate WEBHOOK

WEBHOOK -> WEBHOOK : verifikasi SHA512 signature\n(prod only)

WEBHOOK -> WEBHOOK : mapping status:\ncapture/settlement → SUCCESS\nfraud=challenge → PENDING\ncancel/deny/expire → FAILED

WEBHOOK -> DB : transaction.findUnique(orderId)
activate DB
DB --> WEBHOOK : transaction + userId
deactivate DB

alt Sudah SUCCESS (idempotency)
  WEBHOOK --> SNAP : HTTP 200 "Already processed"
end

alt finalStatus = SUCCESS
  WEBHOOK -> DB : $transaction([\n  transaction.update(SUCCESS)\n  user.update(tier=PRO, promptLimit=0)\n])
  activate DB
  DB --> WEBHOOK : ok (atomic)
  deactivate DB
else FAILED / PENDING
  WEBHOOK -> DB : transaction.update(finalStatus)
  activate DB
  DB --> WEBHOOK : ok
  deactivate DB
end

WEBHOOK --> SNAP : HTTP 200 "OK"
deactivate WEBHOOK

== Self-Healing (jika webhook terlambat) ==

USER -> UI : buka halaman profil
UI -> PROFILE : GET /api/profile
activate PROFILE

PROFILE -> DB : user.findUnique + transaction.findFirst(PENDING)
activate DB
DB --> PROFILE : user (tier=FREE) + pendingTx
deactivate DB

PROFILE -> CORE : transaction.status(orderId)
activate CORE
CORE --> PROFILE : {transaction_status: "settlement"}
deactivate CORE

PROFILE -> DB : $transaction([\n  transaction.update(SUCCESS)\n  user.update(tier=PRO)\n])
activate DB
DB --> PROFILE : ok
deactivate DB

PROFILE --> UI : HTTP 200\n{tier: "PRO"}
deactivate PROFILE

UI --> USER : tampil badge PRO
deactivate UI

@enduml

' ============================================================
' 9. SEQUENCE DIAGRAM — RESET PASSWORD
' ============================================================
@startuml SEQ-05-ResetPassword
title Sequence Diagram — Lupa & Reset Password

skinparam sequence {
  ActorBackgroundColor #FDEBD0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 9
}

actor "Pengguna" as USER
participant "ForgotPassword\nForm" as UI1
participant "ResetPassword\nForm" as UI2
participant "POST /api/auth\n/forgot-password" as API1
participant "POST /api/auth\n/reset-password" as API2
participant "crypto\n(Node.js)" as CRYPTO
database "PostgreSQL\n(Prisma)" as DB
participant "Nodemailer\n(SMTP)" as MAIL
participant "bcryptjs" as BCRYPT

USER -> UI1 : masukkan email
activate UI1

UI1 -> API1 : POST {email}
activate API1

API1 -> API1 : cek rate limit\n(maks 3/15 menit)

API1 -> DB : user.findUnique({email})
activate DB
DB --> API1 : user | null
deactivate DB

note over API1
  Apapun hasilnya (user ada/tidak)
  response selalu HTTP 200 generik
  untuk mencegah user enumeration
end note

alt User ditemukan
  API1 -> CRYPTO : randomBytes(32).toString('hex')
  activate CRYPTO
  CRYPTO --> API1 : resetToken (plaintext)
  deactivate CRYPTO

  API1 -> CRYPTO : SHA256(resetToken) → hashedToken
  activate CRYPTO
  CRYPTO --> API1 : hashedToken
  deactivate CRYPTO

  API1 -> DB : user.update({\n  resetToken: hashedToken\n  resetTokenExpiry: now+1jam\n})
  activate DB
  DB --> API1 : ok
  deactivate DB

  API1 -> MAIL : sendResetPasswordEmail(\n  to: email\n  url: /reset-password?token=resetToken\n)
  activate MAIL
  MAIL --> USER : email berisi link reset
  deactivate MAIL
end

API1 --> UI1 : HTTP 200\n"Jika email terdaftar, link telah dikirim"
deactivate API1
UI1 --> USER : tampil pesan generik
deactivate UI1

USER -> UI2 : klik link di email\nmasukkan password baru
activate UI2

UI2 -> API2 : POST {token, newPassword}
activate API2

alt Token/password kosong
  API2 --> UI2 : HTTP 400
end

alt Password < 8 karakter
  API2 --> UI2 : HTTP 400
end

API2 -> CRYPTO : SHA256(token)
activate CRYPTO
CRYPTO --> API2 : hashedToken
deactivate CRYPTO

API2 -> DB : user.findFirst({\n  resetToken: hashedToken\n  resetTokenExpiry > now()\n})
activate DB
DB --> API2 : user | null
deactivate DB

alt Token tidak valid / expired
  API2 --> UI2 : HTTP 400\n"Token tidak valid"
end

API2 -> BCRYPT : hash(newPassword, 12)
activate BCRYPT
BCRYPT --> API2 : passwordHash baru
deactivate BCRYPT

API2 -> DB : user.update({\n  passwordHash: baru\n  resetToken: null\n  resetTokenExpiry: null\n})
activate DB
DB --> API2 : ok
deactivate DB

API2 --> UI2 : HTTP 200\n"Password berhasil diubah"
deactivate API2

UI2 --> USER : redirect ke halaman login
deactivate UI2

@enduml

' ============================================================
' 10. SEQUENCE DIAGRAM — UPLOAD REGULASI (ADMIN)
' ============================================================
@startuml SEQ-06-AdminUpload
title Sequence Diagram — Admin Tambah Regulasi\n(2 Langkah: Upload File → Simpan Metadata)

skinparam sequence {
  ActorBackgroundColor #FFF3E0
  ActorBorderColor #e67e22
  ParticipantBackgroundColor #EEF4FF
  ParticipantBorderColor #2f6fed
  LifeLineBorderColor #2c3e50
  ArrowColor #2c3e50
  ArrowFontSize 9
}

actor "Admin" as ADMIN
participant "Admin Panel\n(React)" as UI
participant "middleware.js\n(JWT Guard)" as MW
participant "POST /api/admin\n/regulations/upload" as UPLOAD_API
participant "POST /api/admin\n/regulations" as CREATE_API
participant "Supabase\nAdminClient" as SUPABASE
database "PostgreSQL\n(Prisma)" as DB

ADMIN -> UI : pilih file PDF\nisi metadata (title, category, description)
activate UI

== Langkah 1: Upload File PDF ke Supabase Storage ==

UI -> MW : POST FormData {file}\n[Cookie: token=admin_jwt]
activate MW
MW -> MW : jwtVerify(token)\ncek role === ADMIN
alt Tidak authorized
  MW --> UI : HTTP 401/403
  UI --> ADMIN : tampil error
end
MW --> UPLOAD_API : teruskan request
deactivate MW
activate UPLOAD_API

UPLOAD_API -> UPLOAD_API : formData.get("file")
alt File tidak ada
  UPLOAD_API --> UI : HTTP 400 "File wajib diunggah"
end

UPLOAD_API -> UPLOAD_API : validasi file.type === "application/pdf"
alt Bukan PDF
  UPLOAD_API --> UI : HTTP 400 "File harus PDF"
end

UPLOAD_API -> SUPABASE : storage.listBuckets()\n→ cek bucket "legal-documents" ada
activate SUPABASE
SUPABASE --> UPLOAD_API : buckets[]
deactivate SUPABASE

UPLOAD_API -> SUPABASE : storage.upload(\n  "{Date.now()}_{safeFileName}"\n  buffer, {upsert: false}\n)
activate SUPABASE
SUPABASE --> UPLOAD_API : {data} | {error}
deactivate SUPABASE

alt Upload gagal
  UPLOAD_API --> UI : HTTP 500
end

UPLOAD_API -> SUPABASE : storage.getPublicUrl(uniqueFileName)
activate SUPABASE
SUPABASE --> UPLOAD_API : publicUrl
deactivate SUPABASE

UPLOAD_API --> UI : HTTP 200\n{fileUrl, fileName, fileSize}
deactivate UPLOAD_API

note over UI
  Frontend menyimpan fileUrl yang diterima
  untuk dipakai di langkah selanjutnya
end note

== Langkah 2: Simpan Metadata Regulasi ke Database ==

UI -> MW : POST {title, description, fileUrl\ncategory, fileSize, fileName}\n[Cookie: token=admin_jwt]
activate MW
MW -> MW : jwtVerify(token)\ncek role === ADMIN
MW --> CREATE_API : teruskan request
deactivate MW
activate CREATE_API

CREATE_API -> CREATE_API : validasi title && fileUrl wajib ada
alt Data tidak lengkap
  CREATE_API --> UI : HTTP 400
end

CREATE_API -> DB : regulation.create({\n  title, description, fileUrl\n  category, fileSize, fileName\n  isActive: true\n})
activate DB
DB --> CREATE_API : regulation baru
deactivate DB

CREATE_API --> UI : HTTP 200\n{regulation}
deactivate CREATE_API

UI --> ADMIN : tampil notifikasi sukses\nregulasi muncul di daftar
deactivate UI

@enduml
