'==============================================================
' KUMPULAN DIAGRAM UML — SISTEM TANYAHUKUM
' ERD · Arsitektur · Sequence · Use Case · Context Diagram
'==============================================================

' ============================================================
' 1. ERD — ENTITY RELATIONSHIP DIAGRAM
' Berdasarkan Prisma Schema
' ============================================================
@startuml ERD
title ERD — Skema Database TanyaHukum

skinparam linetype ortho
skinparam class {
  BackgroundColor #EEF4FF
  BorderColor #2f6fed
  ArrowColor #2c3e50
  FontSize 11
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #f39c12
}

entity "User" as USER {
  * id : String (UUID) <<PK>>
  --
  supabaseId : String? <<UQ>>
  name : String?
  avatarUrl : String?
  * email : String <<UQ>>
  passwordHash : String?
  * authProvider : String = "CREDENTIALS"
  resetToken : String? <<UQ>>
  resetTokenExpiry : DateTime?
  * role : Role = USER
  personalContext : String?
  * tier : Tier = FREE
  * promptLimit : Int = 50
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "Chat" as CHAT {
  * id : String (UUID) <<PK>>
  --
  * userId : String <<FK>>
  title : String?
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "ChatHistory" as CHATHISTORY {
  * id : String (UUID) <<PK>>
  --
  * userId : String <<FK>>
  * chatId : String <<FK>>
  * role : Role
  * content : String
  * createdAt : DateTime
}

entity "Transaction" as TRANSACTION {
  * id : String (UUID) <<PK>>
  --
  * orderId : String <<UQ>>
  * userId : String <<FK>>
  * amount : Int
  * status : TransactionStatus = PENDING
  paymentUrl : String?
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "Regulation" as REGULATION {
  * id : String (UUID) <<PK>>
  --
  * title : String
  description : String?
  * fileUrl : String
  filePath : String?
  fileName : String?
  fileSize : Int?
  * isProcessed : Boolean = false
  category : String?
  content : String?
  * viewCount : Int = 0
  * isActive : Boolean = true
  * createdAt : DateTime
  * updatedAt : DateTime
}

entity "TrendingIssue" as TRENDING {
  * id : String (UUID) <<PK>>
  --
  * title : String
  * description : String
  * publishDate : DateTime
  newsLink : String?
  location : String?
  * isActive : Boolean = true
  * createdAt : DateTime
  * updatedAt : DateTime
  createdBy : String? <<FK>>
}

entity "SearchLog" as SEARCHLOG {
  * id : String (UUID) <<PK>>
  --
  * query : String
  userId : String? <<FK>>
  * createdAt : DateTime
}

note bottom of USER
  Enum Tier: FREE | PRO
  Enum Role: USER | ADMIN | AI
end note

note bottom of TRANSACTION
  Enum TransactionStatus:
  PENDING | SUCCESS | FAILED
end note

note bottom of REGULATION
  Index: viewCount DESC
end note

note bottom of SEARCHLOG
  Index: createdAt
  Index: query + createdAt
end note

' Relasi
USER ||--o{ CHAT : "memiliki\n(onDelete: Cascade)"
USER ||--o{ CHATHISTORY : "memiliki\n(onDelete: Cascade)"
USER ||--o{ TRANSACTION : "memiliki\n(onDelete: Cascade)"
USER ||--o{ SEARCHLOG : "mencatat\n(optional)"
USER ||--o{ TRENDING : "membuat\n(optional)"

CHAT ||--o{ CHATHISTORY : "berisi\n(onDelete: Cascade)"

@enduml

' ============================================================
' 2. ARSITEKTUR SISTEM
' ============================================================
@startuml ARCH
title Arsitektur Sistem TanyaHukum

skinparam rectangle {
  FontSize 11
}
skinparam component {
  FontSize 11
}
skinparam ArrowColor #2c3e50
skinparam ArrowFontSize 9

' ── LAYER 1: CLIENT ───────────────────────────────────────
package "Client Layer" #EEF4FF {
  component "Browser\n(React 19)" as BROWSER
  component "Next.js App Router\n(SSR + CSR)" as NEXTJS
  component "Komponen UI\n(Tailwind CSS)" as UI
  component "Google Sign-In\nSDK (GSI)" as GSI

  BROWSER --> NEXTJS
  NEXTJS --> UI
  BROWSER --> GSI
}

' ── LAYER 2: API / SERVER ─────────────────────────────────
package "API Layer (Next.js Route Handlers)" #FFF3E0 {
  component "middleware.js\n(JWT Auth Guard\nAdmin Protection)" as MW

  package "Auth Routes" #FDEBD0 {
    component "/api/auth/*\n(register, login\ngoogle, forgot\nreset, logout)" as AUTH
  }

  package "Core Routes" #FDEBD0 {
    component "/api/chat\n(RAG Pipeline)" as CHAT
    component "/api/profile\n(GET/PATCH/DELETE\n/upload)" as PROFILE
    component "/api/regulations\n(list, detail\ndownload)" as REGS
    component "/api/dashboard\n(+ 30s cache)" as DASH
    component "/api/payment\n(checkout, webhook)" as PAY
  }

  package "Admin Routes" #FDEBD0 {
    component "/api/admin/*\n(users, regulations\ntrending, stats\nsearch-logs)" as ADMIN
  }

  MW --> AUTH
  MW --> CHAT
  MW --> PROFILE
  MW --> REGS
  MW --> DASH
  MW --> PAY
  MW --> ADMIN
}

' ── LAYER 3: DATA ─────────────────────────────────────────
package "Data Layer" #D5F5E3 {
  database "PostgreSQL\n(via Supabase)\nPrisma ORM" as DB

  database "Supabase Storage\n- avatars bucket\n- legal-documents bucket" as STORAGE

  component "In-Memory Cache\n(Dashboard 30s\nRate Limiter LRU)" as CACHE
}

' ── LAYER 4: EXTERNAL SERVICES ────────────────────────────
package "External Services" #F5EEF8 {
  component "Google OAuth 2.0\n(verifikasi token\nauto-register)" as GOOGLE

  component "VoyageAI\nvoyage-law-2\n(Text Embedding)" as VOYAGE

  database "Pinecone\nVector DB\n(topK: 50)" as PINECONE

  component "Google Gemini 2.5 Flash\n(LLM, temp: 0.2\nLangChain)" as GEMINI

  component "Midtrans\n(Snap API + CoreAPI\nSandbox Mode)" as MIDTRANS

  component "Nodemailer\n(SMTP Email\nReset Password)" as NODEMAILER
}

' ── CONNECTIONS ───────────────────────────────────────────
NEXTJS --> MW : HTTP Request\n(JWT Cookie)

AUTH --> DB : Prisma ORM
AUTH --> GOOGLE : verifyIdToken
AUTH --> NODEMAILER : sendResetPasswordEmail
AUTH --> CACHE : rateLimit (LRU)

CHAT --> DB : Prisma ORM\n(cek user, limit, simpan history)
CHAT --> VOYAGE : embedQuery
CHAT --> PINECONE : query vector
CHAT --> GEMINI : llm.invoke

PROFILE --> DB : Prisma ORM
PROFILE --> STORAGE : upload avatar
PROFILE --> MIDTRANS : CoreAPI.status (self-healing)

REGS --> DB : Prisma ORM
REGS --> STORAGE : fetch PDF (proxy)

DASH --> DB : Prisma ORM
DASH --> CACHE : in-memory 30s

PAY --> DB : Prisma ORM
PAY --> MIDTRANS : Snap.createTransaction
MIDTRANS --> PAY : webhook notifikasi

ADMIN --> DB : Prisma ORM
ADMIN --> STORAGE : upload PDF

' Note: App menyimpan URL dari STORAGE ke DB (bukan DB → STORAGE)

@enduml

