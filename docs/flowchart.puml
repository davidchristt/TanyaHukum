stop
@enduml

' ============================================================
' 14. ALUR ADMIN — MANAJEMEN PENGGUNA & REGULASI
' ============================================================
@startuml FC-14-Admin
title FC-14: Alur Admin Panel\n(Dilindungi Middleware — Role ADMIN)

skinparam ActivityBackgroundColor #FFF3E0
skinparam ActivityBorderColor #e67e22
skinparam ArrowColor #e67e22
skinparam ActivityStartColor #e67e22
skinparam ActivityEndColor #c0392b

start
:Request masuk ke /api/admin/*;
:Middleware verifikasi JWT + role ADMIN\n(lihat FC-06);

if (Tidak authorized?) then (Ya)
  :HTTP 401 / 403;
  stop
endif

split
partition "Manajemen Pengguna" {
  :GET /api/admin/users\n→ Daftar semua user + statistik\n(chat hari ini, last active);
  split
    :POST /api/admin/users\n→ Buat user manual\n(hash password, simpan ke DB);
  split again
    :PATCH /api/admin/users/[id]\n→ Update tier/role/limit user;
  split again
    :DELETE /api/admin/users/[id]\n→ Hapus user (cascade data);
  end split
}

split again
partition "Manajemen Regulasi" {
  :GET /api/admin/regulations\n→ Daftar semua regulasi\n(termasuk nonaktif);
  split
    :POST /api/admin/regulations/upload\n→ Upload PDF ke Supabase Storage\n"legal-documents" bucket\nSimpan metadata ke DB;
  split again
    :POST /api/admin/regulations\n→ Tambah regulasi baru (manual);
  split again
    :PATCH /api/admin/regulations/[id]\n→ Edit judul/kategori/status aktif;
  split again
    :DELETE /api/admin/regulations/[id]\n→ Hapus regulasi;
  end split
}

split again
partition "Manajemen Isu Terkini" {
  :GET /api/admin/trending\n→ Daftar isu terkini;
  split
    :POST /api/admin/trending\n→ Tambah isu baru;
  split again
    :PATCH /api/admin/trending/[id]\n→ Edit isu;
  split again
    :DELETE /api/admin/trending/[id]\n→ Hapus isu;
  end split
}

split again
partition "Analitik & Logs" {
  :GET /api/admin/dashboard/stats\n→ Statistik lengkap:\n(user, regulasi, chat, storage\npertumbuhan mingguan\ndistribusi kategori & tier);
  :GET /api/admin/search-logs\n→ Log semua pencarian user;
}
end split
stop
@enduml

