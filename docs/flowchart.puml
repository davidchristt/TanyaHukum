' ============================================================
' 12. ALUR PAYMENT — CHECKOUT & WEBHOOK
' ============================================================
@startuml FC-12-Payment
title FC-12: Alur Payment Upgrade PRO\nPOST /api/payment/checkout\nPOST /api/payment/webhook

skinparam ActivityBackgroundColor #EEF4FF
skinparam ActivityBorderColor #2f6fed
skinparam ArrowColor #2f6fed
skinparam ActivityStartColor #2f6fed
skinparam ActivityEndColor #e74c3c

start

partition "Tahap 1 — Checkout" {
  :Pengguna klik "Upgrade ke PRO";
  :Frontend kirim POST /api/payment/checkout\n{userId};

  if (userId tidak ada?) then (Ya)
    :HTTP 401;
    stop
  endif

  :findUnique user berdasarkan userId;

  if (User tidak ditemukan?) then (Ya)
    :HTTP 404;
    stop
  endif

  if (User sudah tier PRO?) then (Ya)
    :HTTP 400\n"Anda sudah berlangganan PRO";
    stop
  endif

  :Generate orderId unik\n(TRX-{timestamp}-{userId[:5]});
  :Simpan transaksi ke DB\n(status: PENDING, amount: 49900);
  :Request Snap token ke Midtrans\n(transaction_details, item_details\ncustomer_details);
  :Update DB dengan paymentUrl\n(redirect_url dari Midtrans);
  :Kembalikan HTTP 200\n{token, redirect_url};
  :Frontend buka Midtrans Snap popup;
  :Pengguna melakukan pembayaran;
}

partition "Tahap 2 — Webhook Notifikasi" {
  :Midtrans kirim POST /api/payment/webhook\n(order_id, transaction_status\nfraud_status, signature_key);

  if (Mode sandbox?) then (Ya)
    :Lewati validasi signature\n(sandbox bypass);
  else (Production)
    :Hitung SHA512 signature\n(orderId + statusCode + amount + serverKey);
    if (Signature tidak cocok?) then (Ya)
      :HTTP 403 "Invalid Signature";
      stop
    endif
  endif

  :Mapping status Midtrans → internal:
  note right
    capture/settlement → SUCCESS
    fraud=challenge → PENDING
    cancel/deny/expire → FAILED
  end note

  :findUnique transaksi berdasarkan orderId;

  if (Transaksi tidak ada di DB?) then (Ya)
    :HTTP 404;
    stop
  endif

  if (Status sudah SUCCESS?) then (Ya)
    :HTTP 200 "Already processed"\n(idempotency);
    stop
  endif

  if (finalStatus = SUCCESS?) then (Ya)
    :Atomic DB transaction:
    note right
      1. Update transaksi → SUCCESS
      2. Update user → tier: PRO
                     promptLimit: 0
    end note
  else (FAILED / PENDING)
    :Update transaksi → finalStatus;
  endif

  :HTTP 200 "OK";
}

partition "Self-Healing (Backup)" {
  :Jika webhook gagal/terlambat,\nsaat user GET /api/profile:;
  :Cek transaksi PENDING di DB;
  if (Ada PENDING?) then (Ya)
    :Cek status ke Midtrans CoreAPI;
    if (Status settlement/capture?) then (Ya)
      :Atomic upgrade user ke PRO\n(sama seperti webhook);
    endif
  endif
}
stop
@enduml

' ============================================================
' 13. ALUR DASHBOARD USER
' ============================================================
@startuml FC-13-Dashboard
title FC-13: Alur Dashboard\nGET /api/dashboard

